/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data:; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; connect-src 'self' https://cloudflareinsights.com; form-action 'self'; upgrade-insecure-requests

/images/*
  Cache-Control: public, max-age=31536000, immutable

/images/optimized/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=31536000, immutable

/brand/korplaylist-logo.png
  Cache-Control: public, max-age=31536000, immutable

/brand/korplaylist-logo-38.png
  Cache-Control: public, max-age=31536000, immutable

/brand/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*.svg
  Cache-Control: public, max-age=31536000, immutable

/favicon.png
  Cache-Control: public, max-age=31536000, immutable

/ads.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Content-Type: text/plain; charset=utf-8

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Revalidate documents; keep the existing long-lived image cache above.
/
  Cache-Control: no-cache, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
/en/*
  Cache-Control: no-cache, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
/ja/*
  Cache-Control: no-cache, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
/travel/*
  Cache-Control: no-cache, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
/regions/*
  Cache-Control: no-cache, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
/categories/*
  Cache-Control: no-cache, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
/about/
  Cache-Control: no-cache, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
/contact/
  Cache-Control: no-cache, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
/privacy/
  Cache-Control: no-cache, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
/terms/
  Cache-Control: no-cache, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
/404.html
  Cache-Control: no-cache, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
