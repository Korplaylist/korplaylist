---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AboutContent from "../../components/AboutContent.astro";
export function getStaticPaths() { return ["en", "ja"].map(locale => ({ params: { locale } })); }
const { locale } = Astro.params;
const title = locale === "en" ? "About Korea Playlist" : "韓国プレイリストについて";
---
<BaseLayout title={title} description={title} canonical={`/${locale}/about/`} locale={locale}>
  <AboutContent locale={locale} />
</BaseLayout>
