---
import { localeLabels, siteConfig } from "../site.config";

const { locale = "ko", alternates = {} } = Astro.props;
const labels = localeLabels[locale] ?? localeLabels.ko;
const siteName = siteConfig.localizedSiteNames[locale] ?? siteConfig.siteName;

const languages = [
  { href: "/", flagImage: "/icons/flag-ko.svg", label: "한국어", code: "KO" },
  { href: "/en/", flagImage: "/icons/flag-en.svg", label: "English", code: "EN" },
  { href: "/ja/", flagImage: "/icons/flag-ja.svg", label: "日本語", code: "JA" }
];
const currentPath = Astro.url.pathname;
const articlePage = /\/travel\/[^/]+\/[^/]+\/$/.test(currentPath);
const languageHref = (language) => {
  const targetLocale = language.code.toLowerCase();
  if (/^\/404(?:\.html)?\/?$/.test(currentPath)) return language.href;
  if (targetLocale === locale) return currentPath;
  if (alternates[targetLocale]) return alternates[targetLocale];
  if (articlePage) return `${language.href}travel/`;
  const sectionPath = currentPath.replace(/^\/(en|ja)\//, '/');
  if (['/travel/', '/about/', '/contact/', '/privacy/', '/terms/', '/regions/', '/categories/'].includes(sectionPath)) return `${language.href}${sectionPath.slice(1)}`;
  return language.href;
};
---

<header class="site-header">
  <a class="brand" href={labels.homeHref} aria-label={labels.homeAria}>
    <img class="brand-logo" src="/brand/korplaylist-logo-38.png" alt="" width="38" height="38" loading="eager" decoding="async" />
    <span>{siteName}</span>
  </a>
  <nav class="nav" aria-label={labels.navLabel}>
    <a href={locale === "ko" ? "/regions/" : `/${locale}/regions/`}>{labels.regions}</a>
    <a href={locale === "ko" ? "/categories/" : `/${locale}/categories/`}>{labels.categories}</a>
    <a href={locale === "ko" ? "/about/" : `/${locale}/about/`}>{labels.about}</a>
    <a href={locale === "ko" ? "/contact/" : `/${locale}/contact/`}>{labels.contact}</a>
  </nav>
  <div class="header-actions">
    <nav class="language-switcher" aria-label={labels.languageLabel}>
      {languages.map((language) => (
        <a class="language-link" href={languageHref(language)} aria-label={language.label} title={language.label} lang={language.code.toLowerCase()} aria-current={language.code.toLowerCase() === locale ? 'page' : undefined}>
          <img class="language-flag" src={language.flagImage} alt="" width="24" height="16" loading="lazy" decoding="async" />
          <span class="language-label">{language.label}</span>
          <span class="language-code">{language.code}</span>
        </a>
      ))}
    </nav>
  </div>
</header>
