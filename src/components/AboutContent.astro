---
import AuthorBio from "./AuthorBio.astro";
import { siteConfig } from "../site.config";
const { locale = "ko" } = Astro.props;
const copy = {
  ko: { title: "한국플레이리스트 소개", intro: "한국플레이리스트는 임채홍이 운영하는 한국 여행 정보 사이트입니다. 공항과 역에서의 이동, 짐보관, 관람 예약, 비용처럼 여행 전에 결정해야 할 문제를 다룹니다.", sections: [
    ["조사형 가이드", "기본 콘텐츠는 운영기관 안내와 공개 자료를 비교해 작성하는 조사형 가이드입니다. 실제 방문·이용 기록이 명시된 경우에만 현장 경험으로 읽어 주세요. 추천 일정과 시간 배분은 편집자의 제안이며 실제 이동 측정 기록과 구분합니다."],
    ["출처와 변경 정보", "요금·운영시간·예약 조건은 해당 기관이나 사업자의 안내를 우선합니다. 확인한 정보에는 출처와 기준일을 표시하고, 확인할 수 없는 세부 사항을 확정값처럼 쓰지 않습니다. 게시일은 최초 공개일이며 업데이트 날짜는 본문을 실제 수정한 날입니다."],
    ["작성과 검수", "자료 정리, 번역, 초안 작성과 오류 탐지에 AI 도구를 활용합니다. AI 문장 자체를 사실의 근거로 사용하지 않으며 검수 책임은 운영자에게 있습니다. 방문 경험이나 사진을 만들어 내지 않습니다. 각 언어의 글은 해당 독자의 이동과 예약 조건에 맞게 편집합니다."],
    ["사진과 도표", "외부 사진은 출처를 표시하며 직접 촬영한 현장 기록으로 제시하지 않습니다. 촬영 당시와 현재 운영 상태는 다를 수 있습니다. 설명도는 실제 지형을 측량한 지도와 구분합니다. 장소 확인이 어려운 장식 이미지는 여행 사실의 근거로 사용하지 않습니다."],
    ["정정 요청", "잘못된 장소·가격·운영 정보가 있다면 글 주소, 문제가 있는 부분, 확인할 수 있는 근거를 보내 주세요. 확인 후 본문과 변경일에 반영합니다. 이미지 권리 요청에는 이미지 위치와 권리자를 확인할 자료를 함께 보내 주세요."] ] },
  en: { title: "About Korea Playlist", intro: "Korea Playlist is edited and operated by Chaehong Lim. It covers airport and station transfers, luggage storage, reservations, walking routes and travel costs.", sections: [
    ["Research-based guides", "Our default format is a desk-researched guide using operator information and public sources. A guide is a first-hand account only when it identifies an actual visit or service used. Suggested itineraries and time buffers are editorial planning choices, not measured journey records."],
    ["Sources and updates", "We prioritize the organization responsible for a fare, opening time or booking rule. Confirmed details include a source and check date; unavailable details should not appear as verified facts. Publication dates identify the original release. Updated dates reflect substantive edits."],
    ["Writing and review", "AI tools assist with research organization, translation, drafting and error detection. Generated text is not evidence. The editor remains responsible for checking claims. We do not invent visits, reviews or photographs. Each language edition addresses its readers' transport and booking needs."],
    ["Images", "Third-party photographs are credited and are not presented as our own fieldwork. Historical photos do not establish current access or conditions. Explanatory diagrams are distinguished from measured maps. Decorative images with uncertain locations are not evidence for travel advice."],
    ["Corrections", "Send the article URL, the detail that needs correction and a supporting source to our contact address. For image-rights requests, identify the image and provide information establishing your rights. Confirmed corrections are reflected in the article and its update date."] ] },
  ja: { title: "韓国プレイリストについて", intro: "韓国プレイリストはイム・チェホンが運営・編集する韓国旅行情報サイトです。空港や駅からの移動、荷物預かり、予約、徒歩ルート、費用を扱います。", sections: [
    ["調査に基づくガイド", "基本の記事は運営機関の案内と公開資料を比較した調査型ガイドです。訪問日や実際の利用記録を明記した場合に限り現地体験として扱います。モデルコースや時間配分は編集上の提案で、実測した移動記録とは区別します。"],
    ["情報源と更新", "料金、営業時間、予約条件は担当機関や事業者の案内を優先します。確認した事項には出典と確認日を示し、未確認の細部を確定情報として書きません。公開日は初回の掲載日、更新日は本文を修正した日です。"],
    ["制作と確認", "資料整理、翻訳、下書き、誤りの検出にAIを利用します。AIの文章を事実の根拠にはせず、確認の責任は編集者が負います。訪問経験、口コミ、写真を作り上げることはしません。各言語の記事は読者の移動や予約の条件に合わせて編集します。"],
    ["写真と説明図", "外部写真には出典を付け、自分で撮影した現地記録として扱いません。撮影時と現在では公開範囲や設備が異なる場合があります。説明図は測量した地図とは区別します。場所を確認できない装飾画像を旅行情報の根拠にはしません。"],
    ["訂正の連絡", "記事のURL、該当箇所、確認できる情報源をご連絡ください。画像の権利に関する連絡では画像の位置と権利者を確認できる資料を添えてください。確認できた訂正は本文と更新日に反映します。"] ] }
}[locale];
---
<section class="page-shell"><h1>{copy.title}</h1><div class="page-copy">
  <p>{copy.intro}</p>
  {copy.sections.map(([heading, paragraph]) => <><h2>{heading}</h2><p>{paragraph}</p></>)}
  <p><a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a></p>
  <AuthorBio locale={locale} compact />
</div></section>
